        <mxCell id="class_club" value="&lt;div style=&quot;color:#FFFFFF;&quot;&gt;&lt;div style=&quot;text-align:center;font-size:14px;&quot;&gt;&lt;b style=&quot;color:#FFFFFF;&quot;&gt;Club&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#93C5FD;font-size:10px;&quot;&gt;(Câu lạc bộ sinh viên)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1.5px solid #60A5FA;margin:5px 0;&quot;/&gt;- _members : List&amp;lt;Member&amp;gt;&lt;br/&gt;+ Id : Guid &lt;span style=&quot;color:#FDE047;font-weight:bold;&quot;&gt;[PK]&lt;/span&gt;&lt;br/&gt;+ Name : string&lt;br/&gt;+ Description : string&lt;br/&gt;+ CreatedAt : DateTime&lt;br/&gt;+ Members : IReadOnlyList&amp;lt;Member&amp;gt;&lt;hr style=&quot;border:0;border-top:1.5px solid #60A5FA;margin:5px 0;&quot;/&gt;+ Create(name: string, desc: string) : Club &lt;span style=&quot;color:#93C5FD;font-weight:bold;&quot;&gt;$&lt;/span&gt;&lt;br/&gt;+ AddMember(member: Member) : void&lt;br/&gt;+ MemberCount() : int&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fontColor=#FFFFFF;fontSize=11;fillColor=#1E3A8A;strokeColor=#60A5FA;strokeWidth=2.2;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="100" width="360" height="290" as="geometry" />
