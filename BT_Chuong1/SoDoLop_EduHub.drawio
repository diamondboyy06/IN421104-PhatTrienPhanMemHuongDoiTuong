        <mxCell id="enum_box" value="&lt;div style=&quot;color:#FFFFFF;&quot;&gt;&lt;div style=&quot;text-align:center;font-size:12px;&quot;&gt;&lt;b style=&quot;color:#E2E8F0;&quot;&gt;&amp;laquo;enumeration&amp;raquo;&lt;br/&gt;MemberStatus&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #94A3B8;margin:4px 0;&quot;/&gt;+ Active&lt;br/&gt;+ Inactive&lt;hr style=&quot;border:0;border-top:1.5px dashed #94A3B8;margin:8px 0;&quot;/&gt;&lt;div style=&quot;text-align:center;font-size:12px;&quot;&gt;&lt;b style=&quot;color:#E2E8F0;&quot;&gt;&amp;laquo;enumeration&amp;raquo;&lt;br/&gt;RegistrationStatus&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #94A3B8;margin:4px 0;&quot;/&gt;+ Pending&lt;br/&gt;+ Confirmed&lt;br/&gt;+ Cancelled&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fontColor=#FFFFFF;fontSize=11;fillColor=#1E293B;strokeColor=#94A3B8;strokeWidth=2;shadow=1;" parent="1" vertex="1">
