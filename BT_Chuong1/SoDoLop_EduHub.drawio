        <mxCell id="class_event" value="&lt;div style=&quot;color:#FFFFFF;&quot;&gt;&lt;div style=&quot;text-align:center;font-size:14px;&quot;&gt;&lt;b style=&quot;color:#FFFFFF;&quot;&gt;Event&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#E9D5FF;font-size:10px;&quot;&gt;(Sự kiện do CLB tổ chức)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1.5px solid #C084FC;margin:5px 0;&quot;/&gt;+ Id : Guid &lt;span style=&quot;color:#FDE047;font-weight:bold;&quot;&gt;[PK]&lt;/span&gt;&lt;br/&gt;+ ClubId : Guid &lt;span style=&quot;color:#38BDF8;font-weight:bold;&quot;&gt;[FK -&amp;gt; Club.Id]&lt;/span&gt;&lt;br/&gt;+ Title : string&lt;br/&gt;+ Date : DateTime&lt;br/&gt;+ Capacity : int&lt;br/&gt;+ IsOnline : bool&lt;hr style=&quot;border:0;border-top:1.5px solid #C084FC;margin:5px 0;&quot;/&gt;+ Create(clubId, title, date, cap, isOnline) : Event &lt;span style=&quot;color:#E9D5FF;font-weight:bold;&quot;&gt;$&lt;/span&gt;&lt;br/&gt;+ HasCapacity(currentCount: int) : bool&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fontColor=#FFFFFF;fontSize=11;fillColor=#581C87;strokeColor=#C084FC;strokeWidth=2.2;shadow=1;" parent="1" vertex="1">
