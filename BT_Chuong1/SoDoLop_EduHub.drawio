        <mxCell id="class_member" value="&lt;div style=&quot;color:#FFFFFF;&quot;&gt;&lt;div style=&quot;text-align:center;font-size:14px;&quot;&gt;&lt;b style=&quot;color:#FFFFFF;&quot;&gt;Member&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#A7F3D0;font-size:10px;&quot;&gt;(Thành viên sinh viên)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1.5px solid #34D399;margin:5px 0;&quot;/&gt;+ Id : Guid &lt;span style=&quot;color:#FDE047;font-weight:bold;&quot;&gt;[PK]&lt;/span&gt;&lt;br/&gt;+ Name : string&lt;br/&gt;+ Email : string&lt;br/&gt;+ StudentCode : string&lt;br/&gt;+ JoinedAt : DateTime&lt;br/&gt;+ Status : MemberStatus&lt;hr style=&quot;border:0;border-top:1.5px solid #34D399;margin:5px 0;&quot;/&gt;+ Create(name: string, email: string, code: string) : Member &lt;span style=&quot;color:#A7F3D0;font-weight:bold;&quot;&gt;$&lt;/span&gt;&lt;br/&gt;+ IsActive() : bool&lt;br/&gt;+ Deactivate() : void&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fontColor=#FFFFFF;fontSize=11;fillColor=#064E3B;strokeColor=#34D399;strokeWidth=2.2;shadow=1;" parent="1" vertex="1">
