        <mxCell id="class_checkin" value="&lt;div style=&quot;color:#FFFFFF;&quot;&gt;&lt;div style=&quot;text-align:center;font-size:14px;&quot;&gt;&lt;b style=&quot;color:#FFFFFF;&quot;&gt;CheckIn&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#99F6E4;font-size:10px;&quot;&gt;(Điểm danh sự kiện)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1.5px solid #2DD4BF;margin:5px 0;&quot;/&gt;+ Id : Guid &lt;span style=&quot;color:#FDE047;font-weight:bold;&quot;&gt;[PK]&lt;/span&gt;&lt;br/&gt;+ RegistrationId : Guid &lt;span style=&quot;color:#38BDF8;font-weight:bold;&quot;&gt;[FK -&amp;gt; Registration.Id]&lt;/span&gt;&lt;br/&gt;+ CheckedInAt : DateTime&lt;br/&gt;+ Method : string&lt;hr style=&quot;border:0;border-top:1.5px solid #2DD4BF;margin:5px 0;&quot;/&gt;+ Create(registration: Registration, method: string) : CheckIn &lt;span style=&quot;color:#99F6E4;font-weight:bold;&quot;&gt;$&lt;/span&gt;&lt;br/&gt;+ Summary() : string&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fontColor=#FFFFFF;fontSize=11;fillColor=#134E4A;strokeColor=#2DD4BF;strokeWidth=2.2;shadow=1;" parent="1" vertex="1">
