        <mxCell id="class_registration" value="&lt;div style=&quot;color:#FFFFFF;&quot;&gt;&lt;div style=&quot;text-align:center;font-size:14px;&quot;&gt;&lt;b style=&quot;color:#FFFFFF;&quot;&gt;Registration&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#FECDD3;font-size:10px;&quot;&gt;(Phiếu đăng ký sự kiện)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1.5px solid #FB7185;margin:5px 0;&quot;/&gt;+ Id : Guid &lt;span style=&quot;color:#FDE047;font-weight:bold;&quot;&gt;[PK]&lt;/span&gt;&lt;br/&gt;+ MemberId : Guid &lt;span style=&quot;color:#38BDF8;font-weight:bold;&quot;&gt;[FK -&amp;gt; Member.Id]&lt;/span&gt;&lt;br/&gt;+ EventId : Guid &lt;span style=&quot;color:#38BDF8;font-weight:bold;&quot;&gt;[FK -&amp;gt; Event.Id]&lt;/span&gt;&lt;br/&gt;+ RegisteredAt : DateTime&lt;br/&gt;+ Status : RegistrationStatus&lt;hr style=&quot;border:0;border-top:1.5px solid #FB7185;margin:5px 0;&quot;/&gt;+ Create(memberId: Guid, eventId: Guid) : Registration &lt;span style=&quot;color:#FECDD3;font-weight:bold;&quot;&gt;$&lt;/span&gt;&lt;br/&gt;+ Confirm() : void&lt;br/&gt;+ Cancel() : void&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fontColor=#FFFFFF;fontSize=11;fillColor=#881337;strokeColor=#FB7185;strokeWidth=2.2;shadow=1;" parent="1" vertex="1">
