        <mxCell id="banner" value="&lt;b style=&quot;color:#FFFFFF;letter-spacing:1px;font-size:16px;&quot;&gt;SƠ ĐỒ LỚP HƯỚNG ĐỐI TƯỢNG (OOP CLASS DIAGRAM) — HỆ THỐNG EDUHUB (IN4211)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;strokeWidth=2.5;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=center;shadow=1;" parent="1" vertex="1">
